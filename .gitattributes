* text=auto

# Large binaries stay in Git LFS to keep clones small.
# *.onnx filter=lfs diff=lfs merge=lfs -text
# openpilot/system/hardware/tici/updater filter=lfs diff=lfs merge=lfs -text

# Image / font / sound types are shipped as REAL blobs in this fork. Declaring
# them as LFS while the committed blob is real content made git-lfs report
# phantom "modified" files ("Encountered files that should have been pointers,
# but weren't") and blocked git pull on agnos. So they are NOT LFS by type.
# -text also keeps them out of EOL renormalization.
*.svg -filter -diff -merge -text
*.png -filter -diff -merge -text
*.gif -filter -diff -merge -text
*.ttf -filter -diff -merge -text
*.otf -filter -diff -merge -text
*.wav -filter -diff -merge -text

# cp-cuda snapshot: LFS disabled for these assets too, so the new repo is
# self-contained (real blobs, no git-lfs dependency). They fall back to the
# type rules above (*.png / *.svg -> -filter, real blob).
# docs/assets/comma-logo.png filter=lfs diff=lfs merge=lfs -text
# openpilot/tools/cabana/assets/cabana-icon.png filter=lfs diff=lfs merge=lfs -text
# openpilot/selfdrive/carrot/web/assets/alert_camera.svg filter=lfs diff=lfs merge=lfs -text
# openpilot/selfdrive/carrot/web/assets/alert_police.svg filter=lfs diff=lfs merge=lfs -text

# dmonitoring model was already shipped as a real blob (supercombo stays LFS).
openpilot/selfdrive/modeld/models/dmonitoring_model.onnx -filter -diff -merge -text
